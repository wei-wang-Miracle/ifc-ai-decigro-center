# ai-rag 服务配置
# 复制此文件为 .env 并填写真实值

# ========================================
# 数据库配置（使用现有 PostgreSQL + pgvector 扩展）
# ========================================
DATABASE_URL=postgresql://postgres:123456@localhost:5432/decigro

# ========================================
# LLM 配置（Moonshot/Kimi）
# LiteLLM 使用 moonshot/<model> 格式，并原生读取 MOONSHOT_API_KEY
# 无需额外配置 base_url，LiteLLM 内置了 https://api.moonshot.cn/v1
# ========================================
MOONSHOT_API_KEY=<your-moonshot-api-key>
LLM_MODEL=moonshot/moonshot-v1-8k

# ========================================
# Embedding 配置 (SiliconFlow - OpenAI 兼容接口)
# LiteLLM 使用 openai/<model> 格式，读取 OPENAI_API_KEY 和 OPENAI_BASE_URL
# 与 MOONSHOT_API_KEY 完全隔离，互不覆盖
# ========================================
EMBEDDING_API_KEY=<your-siliconflow-api-key>
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDER_MODEL=openai/Qwen/Qwen3-Embedding-8B

# ========================================
# 服务配置
# ========================================
AI_RAG_HOST=0.0.0.0
AI_RAG_PORT=8002

# ========================================
# 文件存储配置（本地临时目录，生产环境换成 MinIO/OSS）
# ========================================
UPLOAD_DIR=/tmp/ai_rag_uploads

# ========================================
# 安全配置（共享同一个 bus-kernel 认证机制）
# ========================================
BUS_KERNEL_BASE_URL=http://localhost:8080/api/dg

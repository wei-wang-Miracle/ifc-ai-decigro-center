<mxfile host="app.diagrams.net" modified="2026-03-31T00:00:00.000Z" agent="Claude" version="21.0.0" type="device">
  <diagram id="langgraph-flow" name="AI Engine Graph Flow">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ==================== 标题 ==================== -->
        <mxCell id="title" value="AI Engine - LangGraph 工作流" style="text;html=1;fontSize=20;fontStyle=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="400" y="15" width="600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="StateGraph&lt;AgentState&gt; 节点流转图" style="text;html=1;fontSize=12;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="500" y="50" width="400" height="25" as="geometry" />
        </mxCell>

        <!-- ==================== START 节点 ==================== -->
        <mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="670" y="90" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="start_label" value="Entry Point" style="text;html=1;fontSize=10;fontFamily=Helvetica;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="640" y="75" width="90" height="20" as="geometry" />
        </mxCell>

        <!-- ==================== 1. 意图识别节点 ==================== -->
        <mxCell id="intent" value="&lt;b&gt;意图识别&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#888888;&quot;&gt;intent_recognition_node&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3366CC;strokeColor=#2952A3;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=12;arcSize=20;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="150" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="intent_detail" value="&lt;font style=&quot;font-size:10px;&quot;&gt;• 查询重写（补全指代/省略）&lt;br&gt;• 二元意图: TASK / CHAT / END&lt;br&gt;• LLM structured output&lt;/font&gt;" style="text;html=1;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;fillColor=#EDF2FC;strokeColor=#BDD0F2;rounded=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="800" y="142" width="210" height="55" as="geometry" />
        </mxCell>

        <!-- ==================== 2. 调度中心节点 ==================== -->
        <mxCell id="dispatcher" value="&lt;b&gt;调度中心&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#CCCCCC;&quot;&gt;dispatcher_node&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FF9966;strokeColor=#E07840;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=12;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="615" y="270" width="140" height="110" as="geometry" />
        </mxCell>
        <mxCell id="dispatcher_detail" value="&lt;font style=&quot;font-size:10px;&quot;&gt;路由决策：&lt;br&gt;• require_review → review&lt;br&gt;• TASK + 无plan → planner&lt;br&gt;• TASK + 有plan → executor&lt;br&gt;• TASK + plan完毕 → responder&lt;br&gt;• CHAT → normal&lt;br&gt;• END → __end__&lt;/font&gt;" style="text;html=1;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;fillColor=#FFF3EC;strokeColor=#F2D5C0;rounded=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="800" y="255" width="210" height="115" as="geometry" />
        </mxCell>

        <!-- ==================== 3. 规划节点 ==================== -->
        <mxCell id="planner" value="&lt;b&gt;Planner 规划&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#888888;&quot;&gt;planner_node&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3366CC;strokeColor=#2952A3;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=12;arcSize=20;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="430" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="planner_detail" value="&lt;font style=&quot;font-size:10px;&quot;&gt;• 加载 Planner Agent 配置&lt;br&gt;• 能力边界校验 (feasibility)&lt;br&gt;• 任务拆解 → PlanStep[]&lt;br&gt;• 人机协同标记 (requires_review)&lt;/font&gt;" style="text;html=1;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;fillColor=#EDF2FC;strokeColor=#BDD0F2;rounded=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="50" y="422" width="195" height="65" as="geometry" />
        </mxCell>

        <!-- ==================== 4. 执行节点 ==================== -->
        <mxCell id="executor" value="&lt;b&gt;Executor 执行&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#888888;&quot;&gt;plan_task_execute_node&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3366CC;strokeColor=#2952A3;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=12;arcSize=20;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="470" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="executor_detail" value="&lt;font style=&quot;font-size:10px;&quot;&gt;• Agent + Tool Loop (max 8轮)&lt;br&gt;• 共享黑板 (step_results)&lt;br&gt;• 步骤完成后检查 requires_review&lt;br&gt;• 结论提取 (_extract_conclusion)&lt;/font&gt;" style="text;html=1;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;fillColor=#EDF2FC;strokeColor=#BDD0F2;rounded=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="800" y="462" width="210" height="65" as="geometry" />
        </mxCell>

        <!-- ==================== 5. 人工审核节点 ==================== -->
        <mxCell id="review" value="&lt;b&gt;人工审核&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#888888;&quot;&gt;human_review_node&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E74C3C;strokeColor=#C0392B;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=12;arcSize=20;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="580" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="review_detail" value="&lt;font style=&quot;font-size:10px;&quot;&gt;• interrupt() 暂停等待用户&lt;br&gt;• approve → dispatcher (index+1)&lt;br&gt;• reject → feedback&lt;/font&gt;" style="text;html=1;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;fillColor=#FDEDEC;strokeColor=#F2C0BC;rounded=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="50" y="575" width="195" height="50" as="geometry" />
        </mxCell>

        <!-- ==================== 6. 反馈处理节点 ==================== -->
        <mxCell id="feedback" value="&lt;b&gt;反馈处理&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#888888;&quot;&gt;feedback_handler_node&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E74C3C;strokeColor=#C0392B;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=12;arcSize=20;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="700" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="feedback_detail" value="&lt;font style=&quot;font-size:10px;&quot;&gt;• 关键词 + LLM 分类反馈&lt;br&gt;• 全量重规划 → 清空plan → dispatcher&lt;br&gt;• 局部调整 → 保留feedback → dispatcher&lt;/font&gt;" style="text;html=1;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;fillColor=#FDEDEC;strokeColor=#F2C0BC;rounded=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="50" y="695" width="200" height="55" as="geometry" />
        </mxCell>

        <!-- ==================== 7. 普通对话节点 ==================== -->
        <mxCell id="normal" value="&lt;b&gt;普通对话&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#888888;&quot;&gt;normal_node&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7FBFFF;strokeColor=#5A9FDF;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=12;arcSize=20;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="610" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="normal_detail" value="&lt;font style=&quot;font-size:10px;&quot;&gt;• 处理 CHAT 意图&lt;br&gt;• ReAct Agent + public 工具&lt;br&gt;• 闲聊 / 问答 / 功能引导&lt;/font&gt;" style="text;html=1;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;fillColor=#E8F4FF;strokeColor=#B8D9F2;rounded=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="800" y="608" width="195" height="50" as="geometry" />
        </mxCell>

        <!-- ==================== 8. 响应汇总节点 ==================== -->
        <mxCell id="responder" value="&lt;b&gt;响应汇总&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#888888;&quot;&gt;responder_node&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#27AE60;strokeColor=#1E8449;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=12;arcSize=20;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="740" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="responder_detail" value="&lt;font style=&quot;font-size:10px;&quot;&gt;• 有结果: LLM 汇总 step_results&lt;br&gt;• 有错误: 透传错误信息&lt;br&gt;• 无结果: 透传上游 AIMessage&lt;br&gt;• 审计提交 + 长期记忆 Reflection&lt;/font&gt;" style="text;html=1;fontSize=10;fontFamily=Helvetica;align=left;verticalAlign=top;fillColor=#E8F8F0;strokeColor=#B8E6CC;rounded=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="800" y="733" width="210" height="65" as="geometry" />
        </mxCell>

        <!-- ==================== END 节点 ==================== -->
        <mxCell id="end" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="670" y="860" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="end_outer" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=none;strokeColor=#333333;strokeWidth=2;" vertex="1" parent="1">

# 数据库配置
DATABASE_URL=postgresql://postgres:password@localhost:5432/decigro

# LLM 供应商 (openai/azure)
LLM_PROVIDER=openai

# OpenAI 配置
# 如果使用 Moonshot/Kimi, 请填入 Moonshot API Key 并设置 OPENAI_API_BASE=https://api.moonshot.cn/v1
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1

# LLM 模型配置
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7

# Azure OpenAI 专用配置
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT=

# Bus Kernel 配置
BUS_KERNEL_BASE_URL=http://localhost:8080/api/dg

# 服务配置
AI_ENGINE_HOST=0.0.0.0
AI_ENGINE_PORT=8001
AI_ENGINE_DEBUG=True
